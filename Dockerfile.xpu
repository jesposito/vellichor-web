FROM python:3.11-slim-trixie

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/data/hf-cache \
    PYTHONPATH=/app

# ffmpeg = audio encoding/m4b assembly; espeak-ng = Kokoro G2P fallback /
# non-English phonemization; libsndfile1 = soundfile backend. libze1 (Level
# Zero loader) ships in Debian's own repo.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg espeak-ng libsndfile1 git curl ca-certificates libze1 \
    && rm -rf /var/lib/apt/lists/*

# Intel GPU compute userspace (compute-runtime + IGC) — Intel's apt repo
# (repositories.intel.com/gpu) currently 403s (confirmed 2026-07-01), so pull
# pinned .deb packages straight from the GitHub releases instead, which is
# what Intel's own docs fall back to when the repo is down. Bump these tags
# for newer Battlemage/Xe2 fixes: github.com/intel/compute-runtime/releases
# and github.com/intel/intel-graphics-compiler/releases.
RUN set -eux; \
    tmp="$(mktemp -d)"; cd "$tmp"; \
    CR_TAG=26.22.38646.4; \
    IGC_TAG=v2.36.3; IGC_VER=2.36.3+21719; \
    curl -fLO "https://github.com/intel/compute-runtime/releases/download/${CR_TAG}/intel-opencl-icd_${CR_TAG}-0_amd64.deb"; \
    curl -fLO "https://github.com/intel/compute-runtime/releases/download/${CR_TAG}/libze-intel-gpu1_${CR_TAG}-0_amd64.deb"; \
    curl -fLO "https://github.com/intel/compute-runtime/releases/download/${CR_TAG}/libigdgmm12_22.10.0_amd64.deb"; \
    curl -fLO "https://github.com/intel/intel-graphics-compiler/releases/download/${IGC_TAG}/intel-igc-core-2_${IGC_VER}_amd64.deb"; \
    curl -fLO "https://github.com/intel/intel-graphics-compiler/releases/download/${IGC_TAG}/intel-igc-opencl-2_${IGC_VER}_amd64.deb"; \
    apt-get update && apt-get install -y --no-install-recommends ./*.deb; \
    cd / && rm -rf "$tmp" /var/lib/apt/lists/*

WORKDIR /app

# PyTorch's native XPU backend (mainline since 2.5) — targets Intel Arc
# (Alchemist/Battlemage) via Level Zero. No separate IPEX package needed.
RUN pip install torch --index-url https://download.pytorch.org/whl/xpu

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY app/ /app/

EXPOSE 7777
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s \
    CMD curl -fsS http://localhost:7777/healthz || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7777"]
