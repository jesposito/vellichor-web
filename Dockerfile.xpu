FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/data/hf-cache \
    PYTHONPATH=/app

# ffmpeg = audio encoding/m4b assembly; espeak-ng = Kokoro G2P fallback /
# non-English phonemization; libsndfile1 = soundfile backend.
#
# Intel GPU userspace (Level Zero compute runtime) comes from Intel's own apt
# repo, not Debian's — Debian's bundled compute-runtime lags new Arc silicon
# (Battlemage). Verify the repo path/key below against
# https://dgpu-docs.intel.com/driver/client/overview.html before first build;
# Intel rotates these periodically and this hasn't been build-tested on box.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg espeak-ng libsndfile1 git curl ca-certificates gnupg wget \
    && wget -qO - https://repositories.intel.com/gpu/intel-graphics.key \
        | gpg --dearmor -o /usr/share/keyrings/intel-graphics.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/intel-graphics.gpg] https://repositories.intel.com/gpu/debian bookworm client" \
        > /etc/apt/sources.list.d/intel-gpu.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        intel-opencl-icd intel-level-zero-gpu level-zero \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# PyTorch's native XPU backend (mainline since 2.5) — targets Intel Arc
# (Alchemist/Battlemage) via Level Zero. No separate IPEX package needed.
RUN pip install torch --index-url https://download.pytorch.org/whl/xpu

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY app/ /app/

EXPOSE 7777
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s \
    CMD curl -fsS http://localhost:7777/healthz || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7777"]
